    "section": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Be Vietnam Pro",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Be Vietnam Pro",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    }
